{
  "name": "stubs",
  "version": "1.0.0",
  "description": "stubs AI Agent Skill",
  "main": ".agents/skills/stubs/dist/cli.cjs",
  "bin": {
    "stubs": ".agents/skills/stubs/dist/cli.cjs"
  },
  "files": [
    ".agents/skills/stubs/",
    ".stubs/templates/",
    "src/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "npm run build",
    "prepare": "npm run build",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --outfile=.agents/skills/stubs/dist/cli.cjs --banner:js=\"#!/usr/bin/env node\" --external:sqlite3 && node scripts/copy-runtime-assets.js",
    "build:web": "node scripts/build-web.js",
    "predeploy:pages": "npm run build:web",
    "deploy:pages": "gh-pages -d dist/web",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node .agents/skills/stubs/dist/cli.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiltermoodj/stubs.git"
  },
  "keywords": [
    "stubs",
    "agent",
    "sidecar",
    "architecture",
    "okf",
    "specification"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Wiltermoodj/stubs/issues"
  },
  "homepage": "https://github.com/Wiltermoodj/stubs#readme",
  "dependencies": {
    "esbuild": "^0.24.0",
    "js-yaml": "^5.2.3",
    "sql.js": "^1.14.1",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/sql.js": "^1.4.11",
    "@types/sqlite3": "^3.1.11",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "gh-pages": "^6.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.66.0"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
