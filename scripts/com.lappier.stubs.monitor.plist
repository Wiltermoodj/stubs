<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lappier.stubs.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/lappier/code/projects/stubs/scripts/monitor-loop.sh</string>
    </array>
    <!-- Run monitor DIRECTLY. Do NOT point at a double-forking launcher; launchd
         tracks the whole process group and would reap the monitor when the launcher exits. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/lappier/code/projects/stubs</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/lappier/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/lappier</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/lappier/code/projects/stubs/.desktop/monitor.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lappier/code/projects/stubs/.desktop/monitor.err.log</string>
</dict>
</plist>
